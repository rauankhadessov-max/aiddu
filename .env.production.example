# ВАЖНО: значения без кавычек и без пробелов — этот файл читают
# и Laravel, и docker compose (подстановка ${DB_...} в docker-compose.yml).

APP_NAME=PravovoyAI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aiddu.asia

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aiddu
DB_USERNAME=aiddu
# Сгенерируйте: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@aiddu.asia
MAIL_FROM_NAME=PravovoyAI

# Обязательно для работы анализа
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

VITE_APP_NAME=PravovoyAI
